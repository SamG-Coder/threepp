<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ThreeBrowser</RootNamespace>
    <AssemblyName>ThreeBrowser</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3296.44" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\build\bin\three_native.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\build\bin\three_native.dll')" />
    <Content Include="web\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
