#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelScene;
layout(rgba16f, set = 0, binding = 1) uniform writeonly image2D outputColor;
layout(set = 0, binding = 2) uniform sampler2D sourceColor;
layout(set = 0, binding = 3) uniform sampler2D sceneDepth;
layout(set = 0, binding = 4) uniform sampler2D normalRoughness;
layout(set = 0, binding = 5) uniform sampler2D specularAlbedo;
layout(std430, set = 0, binding = 6) readonly buffer TriangleRadiance {
    vec4 terminalRadiance[];
};
// The BLAS consumes tightly-packed vec3 positions and uint indices. Expose the
// same buffers as scalar arrays so std430 does not introduce a vec3 stride.
layout(std430, set = 0, binding = 7) readonly buffer ScenePositions {
    float worldPositions[];
};
layout(std430, set = 0, binding = 8) readonly buffer SceneIndices {
    uint worldIndices[];
};
layout(std430, set = 0, binding = 9) readonly buffer TriangleSurface {
    // linear albedo RGB and perceptual roughness.
    vec4 surfaceResponse[];
};
layout(std430, set = 0, binding = 10) readonly buffer StaticLights {
    // Four vec4s per light: position/range, direction/outerCos,
    // linear color/intensity, innerCos/type/decay/reserved.
    vec4 staticLightRecords[];
};
#if defined(THREEBROWSER_REFLECTIONS_V2)
    #if defined(THREEBROWSER_HIT_DISTANCE_R32)
layout(r32f, set = 0, binding = 11) uniform writeonly image2D specularHitDistanceOutput;
    #else
layout(r16f, set = 0, binding = 11) uniform writeonly image2D specularHitDistanceOutput;
    #endif
#endif
layout(std430, set = 0, binding = 12) readonly buffer DynamicPositions {
    // rgba32float texture copies retain their 16-byte texel stride.
    vec4 dynamicWorldPositions[];
};
layout(std430, set = 0, binding = 13) readonly buffer DynamicIndices {
    uint dynamicWorldIndices[];
};
layout(std430, set = 0, binding = 14) readonly buffer DynamicReflectionMaterial {
    vec4 dynamicTerminalRadiance;
    // Uniform metallic F0 RGB and perceptual roughness.
    vec4 dynamicSurfaceResponse;
};

layout(push_constant) uniform ReflectionConstants {
    mat4 inverseViewProjection;
    vec4 cameraPosition;
    // x strength, y maximum distance, z ray-origin bias, w roughness cutoff.
    vec4 parameters;
    // linear RGB and intensity used when a reflection ray misses the TLAS.
    vec4 environment;
    // xy extent, z flags, w frame index.
    uvec4 extentFlags;
} frame;

const uint kDepthInverted = 1u;
const uint kTemporalJitter = 2u;
const uint kHighQuality = 4u;
// The native bridge reserves bit 7 for the dynamic triangle-mesh instance.
// Clearing it makes the material bounce see only the immutable room scene.
const uint kStaticRoomCullMask = 0x7fu;
const float kTwoPi = 6.28318530717958647692;

void storeSpecularHitDistance(ivec2 pixel, float distanceToHit) {
#if defined(THREEBROWSER_REFLECTIONS_V2)
    // Zero is the portable no-guide sentinel consumed by Ray Reconstruction.
    // Positive values are linear world-space distance along the reflection ray
    // and therefore use the same units as the scene/TLAS.
    imageStore(specularHitDistanceOutput, pixel,
               vec4(max(distanceToHit, 0.0), 0.0, 0.0, 0.0));
#endif
}

uint hash(uint value) {
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    return value ^ (value >> 16u);
}

float randomRotation(ivec2 pixel) {
    // Without a temporal history/denoiser, per-pixel rotations turn low-sample
    // glossy reflections into persistent salt-and-pepper noise. Use one
    // coherent golden-angle kernel for the stable path; only scramble it when
    // a caller explicitly opts into temporal accumulation.
    if ((frame.extentFlags.z & kTemporalJitter) == 0u) return 0.0;
    uint state = uint(pixel.x) * 1973u ^ uint(pixel.y) * 9277u ^ 0x68bc21ebu;
    state ^= frame.extentFlags.w * 26699u;
    return float(hash(state) & 0x00ffffffu) / float(0x01000000u);
}

float readDepth(ivec2 pixel) {
    return texelFetch(sceneDepth, pixel, 0).r;
}

bool isBackground(float depth) {
    return (frame.extentFlags.z & kDepthInverted) != 0u
        ? depth <= 1e-6
        : depth >= 0.999999;
}

vec3 reconstructWorld(ivec2 pixel, float depth) {
    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(frame.extentFlags.xy);
    vec4 clip = vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0);
    vec4 world = frame.inverseViewProjection * clip;
    return world.xyz / max(abs(world.w), 1e-8);
}

void basis(vec3 normal, out vec3 tangent, out vec3 bitangent) {
    vec3 up = abs(normal.z) < 0.999 ? vec3(0.0, 0.0, 1.0)
                                    : vec3(1.0, 0.0, 0.0);
    tangent = normalize(cross(up, normal));
    bitangent = cross(normal, tangent);
}

// A deterministic golden-angle sequence keeps the result stable without
// requiring temporal history. Full-quality reflections deliberately spend the
// available RTX headroom on four/eight default samples or eight/sixteen when a
// page explicitly selects the cinematic tier; mirror surfaces stay at one
// exact ray.
vec3 ggxReflection(vec3 viewDirection, vec3 normal, float roughness,
                   int sampleIndex, int sampleCount, float rotation) {
    if (sampleCount == 1) return reflect(-viewDirection, normal);
    float alpha = max(roughness * roughness, 0.0016);
    float u = (float(sampleIndex) + 0.5) / float(sampleCount);
    float phi = kTwoPi * fract(float(sampleIndex) * 0.38196601125 + rotation);
    float cosTheta = sqrt((1.0 - u) /
        max(1.0 + (alpha * alpha - 1.0) * u, 1e-6));
    float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
    vec3 tangent;
    vec3 bitangent;
    basis(normal, tangent, bitangent);
    vec3 halfVector = normalize(tangent * (sinTheta * cos(phi)) +
                                bitangent * (sinTheta * sin(phi)) +
                                normal * cosTheta);
    vec3 direction = reflect(-viewDirection, halfVector);
    return dot(direction, normal) > 1e-5
        ? normalize(direction)
        : normalize(reflect(-viewDirection, normal));
}

vec3 missRadiance(vec3 direction) {
    float sky = smoothstep(-0.30, 0.85, direction.y);
    float horizon = mix(0.20, 1.10, sky);
    return max(frame.environment.rgb, vec3(0.0)) *
           max(frame.environment.a, 0.0) * horizon;
}

uint staticPrimitiveCount() {
    return uint(worldIndices.length()) / 3u;
}

bool isDynamicHit(uint primitiveBase) {
    // Native assigns the dynamic TLAS slot immediately after every primitive
    // represented by the immutable static/index-group buffers.
    return primitiveBase == staticPrimitiveCount();
}

vec3 staticPositionAt(uint vertex) {
    uint scalar = vertex * 3u;
    return vec3(worldPositions[scalar + 0u],
                worldPositions[scalar + 1u],
                worldPositions[scalar + 2u]);
}

vec3 dynamicPositionAt(uint vertex) {
    return dynamicWorldPositions[vertex].xyz;
}

vec3 primitiveNormal(uint primitiveBase, uint localPrimitive,
                     mat4x3 objectToWorld,
                     vec3 incomingDirection) {
    bool dynamicHit = isDynamicHit(primitiveBase);
    uint primitive = dynamicHit
        ? localPrimitive
        : primitiveBase + localPrimitive;
    uint first = primitive * 3u;
    uint indexCount = dynamicHit
        ? uint(dynamicWorldIndices.length())
        : uint(worldIndices.length());
    if (first + 2u >= indexCount) return normalize(-incomingDirection);
    uint i0 = dynamicHit ? dynamicWorldIndices[first + 0u]
                         : worldIndices[first + 0u];
    uint i1 = dynamicHit ? dynamicWorldIndices[first + 1u]
                         : worldIndices[first + 1u];
    uint i2 = dynamicHit ? dynamicWorldIndices[first + 2u]
                         : worldIndices[first + 2u];
    vec3 p0 = objectToWorld * vec4(
        dynamicHit ? dynamicPositionAt(i0) : staticPositionAt(i0), 1.0);
    vec3 p1 = objectToWorld * vec4(
        dynamicHit ? dynamicPositionAt(i1) : staticPositionAt(i1), 1.0);
    vec3 p2 = objectToWorld * vec4(
        dynamicHit ? dynamicPositionAt(i2) : staticPositionAt(i2), 1.0);
    vec3 normal = cross(p1 - p0, p2 - p0);
    float magnitude = length(normal);
    if (magnitude < 1e-8) return normalize(-incomingDirection);
    normal /= magnitude;
    return dot(normal, -incomingDirection) < 0.0 ? -normal : normal;
}

bool shadowed(vec3 origin, vec3 direction, float minimumDistance,
              float maximumDistance) {
    if (maximumDistance <= minimumDistance) return false;
    rayQueryEXT query;
    rayQueryInitializeEXT(query, topLevelScene,
        gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
        0xffu, origin, minimumDistance, direction, maximumDistance);
    while (rayQueryProceedEXT(query)) {}
    return rayQueryGetIntersectionTypeEXT(query, true) !=
           gl_RayQueryCommittedIntersectionNoneEXT;
}

vec4 surfaceAtHit(uint primitiveBase, uint localPrimitive) {
    if (isDynamicHit(primitiveBase)) return dynamicSurfaceResponse;
    uint primitive = primitiveBase + localPrimitive;
    uint surfaceCount = uint(surfaceResponse.length());
    return surfaceCount == 0u
        ? vec4(0.0)
        : surfaceResponse[min(primitive, surfaceCount - 1u)];
}

vec3 terminalAtHit(uint primitiveBase, uint localPrimitive) {
    if (isDynamicHit(primitiveBase)) {
        return max(dynamicTerminalRadiance.rgb, vec3(0.0));
    }
    uint primitive = primitiveBase + localPrimitive;
    uint count = uint(terminalRadiance.length());
    return count == 0u
        ? vec3(0.0)
        : max(terminalRadiance[min(primitive, count - 1u)].rgb, vec3(0.0));
}

vec3 directLightAtHit(uint primitiveBase, uint localPrimitive,
                      mat4x3 objectToWorld,
                      vec3 hitPoint, vec3 incomingDirection) {
    vec4 surface = surfaceAtHit(primitiveBase, localPrimitive);
    vec3 albedo = max(surface.rgb, vec3(0.0));
    vec3 normal = primitiveNormal(
        primitiveBase, localPrimitive, objectToWorld, incomingDirection);
    float positionScale = max(1.0, max(abs(hitPoint.x),
                                      max(abs(hitPoint.y), abs(hitPoint.z))));
    float rayBias = max(frame.parameters.z, positionScale * 2e-6);
    uint lightCount = min(uint(staticLightRecords.length()) / 4u, 8u);
    vec3 irradiance = vec3(0.0);
    for (uint lightIndex = 0u; lightIndex < lightCount; ++lightIndex) {
        uint first = lightIndex * 4u;
        vec4 positionRange = staticLightRecords[first + 0u];
        vec4 directionOuter = staticLightRecords[first + 1u];
        vec4 colorIntensity = staticLightRecords[first + 2u];
        vec4 coneTypeDecay = staticLightRecords[first + 3u];
        float intensity = max(colorIntensity.a, 0.0);
        if (intensity <= 0.0 || all(lessThanEqual(colorIntensity.rgb, vec3(0.0)))) {
            continue;
        }

        vec3 toLight = positionRange.xyz - hitPoint;
        float distanceToLight = length(toLight);
        if (distanceToLight <= rayBias) continue;
        float range = max(positionRange.w, 0.0);
        if (range > 0.0 && distanceToLight >= range) continue;
        vec3 lightDirection = toLight / distanceToLight;
        float normalDotLight = max(dot(normal, lightDirection), 0.0);
        if (normalDotLight <= 0.0) continue;

        vec3 offsetNormal = dot(normal, lightDirection) >= 0.0
            ? normal
            : -normal;
        vec3 shadowOrigin = hitPoint + offsetNormal * rayBias;
        vec3 shadowVector = positionRange.xyz - shadowOrigin;
        float shadowLength = length(shadowVector);
        if (shadowLength <= 0.0) continue;
        vec3 shadowDirection = shadowVector / shadowLength;
        float shadowTMin = max(positionScale * 5e-7, rayBias * 0.25);
        float shadowTMax = shadowLength - shadowTMin;

        float cone = 1.0;
        int type = int(round(coneTypeDecay.y));
        if (type == 1) {
            float directionLength = length(directionOuter.xyz);
            if (directionLength <= 1e-6) continue;
            vec3 emittedDirection = directionOuter.xyz / directionLength;
            float angleCos = dot(emittedDirection, -lightDirection);
            float outerCos = clamp(directionOuter.w, -1.0, 1.0);
            float innerCos = clamp(coneTypeDecay.x, outerCos, 1.0);
            cone = smoothstep(outerCos, max(innerCos, outerCos + 1e-5), angleCos);
            if (cone <= 1e-5) continue;
        }

        float rangeFade = 1.0;
        if (range > 0.0) {
            float normalizedDistance = clamp(distanceToLight / range, 0.0, 1.0);
            float edge = max(1.0 - normalizedDistance * normalizedDistance *
                                   normalizedDistance * normalizedDistance, 0.0);
            rangeFade = edge * edge;
        }
        float decay = max(coneTypeDecay.z, 0.0);
        float attenuation = rangeFade /
            max(pow(max(distanceToLight, 1.0), decay), 1e-4);
        if (shadowed(shadowOrigin, shadowDirection, shadowTMin, shadowTMax)) {
            continue;
        }
        irradiance += max(colorIntensity.rgb, vec3(0.0)) * intensity *
                      attenuation * cone * normalDotLight;
    }
    const float inversePi = 0.31830988618379067154;
    return albedo * irradiance * inversePi;
}

vec3 traceStaticRoomRadiance(vec3 origin, vec3 direction,
                             float maximumDistance) {
    rayQueryEXT query;
    rayQueryInitializeEXT(query, topLevelScene, gl_RayFlagsOpaqueEXT,
                          kStaticRoomCullMask, origin, 0.0, direction,
                          maximumDistance);
    while (rayQueryProceedEXT(query)) {}
    if (rayQueryGetIntersectionTypeEXT(query, true) ==
        gl_RayQueryCommittedIntersectionNoneEXT) {
        return missRadiance(direction);
    }

    uint primitiveBase =
        rayQueryGetIntersectionInstanceCustomIndexEXT(query, true);
    uint localPrimitive =
        rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
    mat4x3 objectToWorld =
        rayQueryGetIntersectionObjectToWorldEXT(query, true);
    float distanceToHit = rayQueryGetIntersectionTEXT(query, true);
    vec3 hitPoint = origin + direction * distanceToHit;
    return terminalAtHit(primitiveBase, localPrimitive) + directLightAtHit(
        primitiveBase, localPrimitive, objectToWorld, hitPoint, direction);
}

vec3 dynamicMaterialBounce(uint primitiveBase, uint localPrimitive,
                           mat4x3 objectToWorld, vec3 hitPoint,
                           vec3 incomingDirection, float remainingDistance,
                           vec3 baseRadiance) {
    vec3 normal = primitiveNormal(
        primitiveBase, localPrimitive, objectToWorld, incomingDirection);
    vec3 viewDirection = normalize(-incomingDirection);
    vec4 surface = surfaceAtHit(primitiveBase, localPrimitive);
    vec3 f0 = clamp(surface.rgb, vec3(0.0), vec3(1.0));
    float roughness = clamp(surface.a, 0.0, 1.0);
    float positionScale = max(1.0, max(abs(hitPoint.x),
                                      max(abs(hitPoint.y), abs(hitPoint.z))));
    float rayBias = max(frame.parameters.z, positionScale * 2e-6);
    if (remainingDistance <= rayBias) return baseRadiance;

    // One stable GGX sample gives the dynamic material its configured
    // roughness without introducing recursive ray queries. The secondary
    // query excludes the dynamic instance, so this is strictly
    // mirror -> dynamic mesh -> static room.
    uint seed = hash(localPrimitive ^ floatBitsToUint(hitPoint.x) ^
                     hash(floatBitsToUint(hitPoint.z)));
    // Keep polished metals on the same exact, stable mirror direction used by
    // the primary reflection path; rougher materials select one stable GGX
    // lobe sample.
    int sampleCount = roughness < 0.08 ? 1 : 4;
    int sampleIndex = int(seed % uint(sampleCount));
    float rotation = float(hash(seed) & 0x00ffffffu) /
                     float(0x01000000u);
    vec3 reflectedDirection = ggxReflection(
        viewDirection, normal, roughness, sampleIndex, sampleCount, rotation);
    vec3 reflectedOrigin = hitPoint + normal * rayBias;
    vec3 reflectedRadiance = traceStaticRoomRadiance(
        reflectedOrigin, reflectedDirection, remainingDistance - rayBias);

    float normalDotView = clamp(dot(normal, viewDirection), 0.0, 1.0);
    vec3 fresnel = f0 + (vec3(1.0) - f0) *
                   pow(1.0 - normalDotView, 5.0);
    return baseRadiance * (vec3(1.0) - fresnel) +
           reflectedRadiance * fresnel;
}

vec3 traceTerminalRadiance(vec3 origin, vec3 direction, float maximumDistance,
                           out float hitDistance) {
    hitDistance = 0.0;
    rayQueryEXT query;
    rayQueryInitializeEXT(query, topLevelScene, gl_RayFlagsOpaqueEXT,
                          0xffu, origin, 0.0, direction, maximumDistance);
    while (rayQueryProceedEXT(query)) {}
    if (rayQueryGetIntersectionTypeEXT(query, true) ==
        gl_RayQueryCommittedIntersectionNoneEXT) {
        return missRadiance(direction);
    }
    uint primitiveBase =
        rayQueryGetIntersectionInstanceCustomIndexEXT(query, true);
    uint localPrimitive =
        rayQueryGetIntersectionPrimitiveIndexEXT(query, true);
    mat4x3 objectToWorld =
        rayQueryGetIntersectionObjectToWorldEXT(query, true);
    float distanceToHit = rayQueryGetIntersectionTEXT(query, true);
    hitDistance = distanceToHit;
    vec3 hitPoint = origin + direction * distanceToHit;
    vec3 terminal = terminalAtHit(primitiveBase, localPrimitive);
    // A second ray-query pass supplies direct light visibility at the reflected
    // hit. Transparent panes are deliberately absent from the static TLAS, so
    // light can enter through glazing while opaque walls and frames still cast
    // correct shadows. The shaded hit then becomes a true one-bounce source.
    vec3 baseRadiance = terminal + directLightAtHit(
        primitiveBase, localPrimitive, objectToWorld, hitPoint, direction);
    if (!isDynamicHit(primitiveBase)) return baseRadiance;
    return dynamicMaterialBounce(
        primitiveBase, localPrimitive, objectToWorld, hitPoint, direction,
        maximumDistance - distanceToHit, baseRadiance);
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, ivec2(frame.extentFlags.xy)))) return;

    vec4 base = texelFetch(sourceColor, pixel, 0);
    float depth = readDepth(pixel);
    if (isBackground(depth)) {
        imageStore(outputColor, pixel, base);
        storeSpecularHitDistance(pixel, 0.0);
        return;
    }

    vec4 normalAndRoughness = texelFetch(normalRoughness, pixel, 0);
    vec4 specular = texelFetch(specularAlbedo, pixel, 0);
    float normalLength = length(normalAndRoughness.xyz);
    float roughness = clamp(normalAndRoughness.w, 0.0, 1.0);
    float roughnessCutoff = clamp(frame.parameters.w, 0.02, 1.0);
    float reflectionMask = clamp(specular.a, 0.0, 1.0);
    if (normalLength < 1e-4 || roughness >= roughnessCutoff ||
        reflectionMask <= 1e-4 || frame.parameters.x <= 0.0) {
        imageStore(outputColor, pixel, base);
        storeSpecularHitDistance(pixel, 0.0);
        return;
    }

    vec3 world = reconstructWorld(pixel, depth);
    vec3 viewDirection = normalize(frame.cameraPosition.xyz - world);
    vec3 normal = normalAndRoughness.xyz / normalLength;
    if (dot(normal, viewDirection) < 0.0) normal = -normal;
    float bias = max(frame.parameters.z, 1e-5);
    vec3 origin = world + normal * bias;
    float maximumDistance = max(frame.parameters.y, bias * 2.0);

    bool highQuality = (frame.extentFlags.z & kHighQuality) != 0u;
    int sampleCount = roughness < 0.06
        ? 1
        : (roughness < 0.16
            ? (highQuality ? 8 : 4)
            : (highQuality ? 16 : 8));
    float rotation = randomRotation(pixel);
    vec3 reflected = vec3(0.0);
    float primaryHitDistance = 0.0;
    for (int sampleIndex = 0; sampleIndex < sampleCount; ++sampleIndex) {
        vec3 direction = ggxReflection(viewDirection, normal, roughness,
                                       sampleIndex, sampleCount, rotation);
        float sampleHitDistance = 0.0;
        reflected += traceTerminalRadiance(origin, direction, maximumDistance,
                                            sampleHitDistance);
        if (sampleIndex == 0) primaryHitDistance = sampleHitDistance;
    }
    reflected /= float(sampleCount);

    float normalDotView = clamp(dot(normal, viewDirection), 0.0, 1.0);
    vec3 f0 = clamp(specular.rgb, vec3(0.0), vec3(1.0));
    vec3 fresnel = f0 + (vec3(1.0) - f0) *
                   pow(1.0 - normalDotView, 5.0);
    vec3 weight = clamp(fresnel * reflectionMask * frame.parameters.x,
                        vec3(0.0), vec3(1.0));
    vec3 composite = base.rgb * (vec3(1.0) - weight) + reflected * weight;
    imageStore(outputColor, pixel, vec4(composite, base.a));
    storeSpecularHitDistance(pixel, primaryHitDistance);
}
