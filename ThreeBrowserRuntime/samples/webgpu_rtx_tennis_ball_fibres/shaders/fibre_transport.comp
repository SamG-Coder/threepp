#version 460
#extension GL_EXT_ray_query : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelScene;
layout(rgba16f, set = 0, binding = 1) uniform image2D hdrColor;
layout(set = 0, binding = 2) uniform sampler2D sceneDepth;

// Public lighting-v1 ABI. The shader is entirely project-owned; the Runtime
// supplies only the registered triangle scene, command ordering and bindings.
layout(push_constant) uniform FrameConstants {
    mat4 inverseViewProjection;
    vec4 cameraPositionMaximumDistance;
    vec4 directionalLightDirectionAngularRadius;
    vec4 lightingParameters;
    uvec4 extentFlags;
} frame;

const uint kDepthInverted = 1u;
const uint kDirectionalSampleShift = 8u;
const uint kAoSampleShift = 16u;
const uint kSampleMask = 0xffu;

float readDepth(ivec2 pixel) {
    pixel = clamp(pixel, ivec2(0), ivec2(frame.extentFlags.xy) - ivec2(1));
    return texelFetch(sceneDepth, pixel, 0).r;
}

bool isBackground(float depth) {
    return (frame.extentFlags.z & kDepthInverted) != 0u
        ? depth <= 1e-6
        : depth >= 0.999999;
}

vec3 reconstructWorld(ivec2 pixel, float depth) {
    pixel = clamp(pixel, ivec2(0), ivec2(frame.extentFlags.xy) - ivec2(1));
    vec2 uv = (vec2(pixel) + vec2(0.5)) / vec2(frame.extentFlags.xy);
    vec4 clip = vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, depth, 1.0);
    vec4 world = frame.inverseViewProjection * clip;
    return world.xyz / max(abs(world.w), 1e-8);
}

float firstHitDistance(vec3 origin, vec3 direction, float maximumDistance) {
    rayQueryEXT query;
    rayQueryInitializeEXT(query, topLevelScene,
        gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
        0xffu, origin, 0.0, direction, maximumDistance);
    while (rayQueryProceedEXT(query)) {}
    if (rayQueryGetIntersectionTypeEXT(query, true) ==
        gl_RayQueryCommittedIntersectionNoneEXT) return maximumDistance;
    return rayQueryGetIntersectionTEXT(query, true);
}

uint hash(uint value) {
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    return value ^ (value >> 16u);
}

float random01(inout uint state) {
    state = hash(state);
    return float(state & 0x00ffffffu) / float(0x01000000u);
}

vec3 cosineHemisphere(vec3 normal, inout uint state) {
    float u1 = random01(state);
    float u2 = random01(state);
    float radius = sqrt(u1);
    float angle = 6.28318530718 * u2;
    vec3 tangent = normalize(abs(normal.y) < 0.98
        ? cross(normal, vec3(0.0, 1.0, 0.0))
        : cross(normal, vec3(1.0, 0.0, 0.0)));
    vec3 bitangent = cross(normal, tangent);
    return normalize(tangent * (radius * cos(angle)) +
                     bitangent * (radius * sin(angle)) +
                     normal * sqrt(max(0.0, 1.0 - u1)));
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, ivec2(frame.extentFlags.xy)))) return;
    float depth = readDepth(pixel);
    if (isBackground(depth)) return;

    vec4 source = imageLoad(hdrColor, pixel);
    vec3 base = max(source.rgb, vec3(0.0));
    float greenExcess = base.g - max(base.r, base.b);
    // Resolve the material mask before tracing. A wide kitchen view contains
    // very few felt pixels, so this avoids tens of millions of irrelevant
    // room rays while leaving the already-rasterized pixel untouched.
    float fibreMask = smoothstep(0.070, 0.19, greenExcess) *
        smoothstep(0.11, 0.28, base.g);
    if (fibreMask <= 0.001) return;

    vec3 world = reconstructWorld(pixel, depth);
    vec3 left = reconstructWorld(pixel - ivec2(1, 0), readDepth(pixel - ivec2(1, 0)));
    vec3 right = reconstructWorld(pixel + ivec2(1, 0), readDepth(pixel + ivec2(1, 0)));
    vec3 up = reconstructWorld(pixel - ivec2(0, 1), readDepth(pixel - ivec2(0, 1)));
    vec3 down = reconstructWorld(pixel + ivec2(0, 1), readDepth(pixel + ivec2(0, 1)));
    vec3 dxForward = right - world;
    vec3 dxBackward = world - left;
    vec3 dyForward = down - world;
    vec3 dyBackward = world - up;
    vec3 dx = dot(dxForward, dxForward) < dot(dxBackward, dxBackward)
        ? dxForward : dxBackward;
    vec3 dy = dot(dyForward, dyForward) < dot(dyBackward, dyBackward)
        ? dyForward : dyBackward;
    vec3 normal = normalize(cross(dy, dx));
    vec3 toCamera = normalize(frame.cameraPositionMaximumDistance.xyz - world);
    if (any(isnan(normal)) || any(isinf(normal))) normal = vec3(0.0, 1.0, 0.0);
    if (dot(normal, toCamera) < 0.0) normal = -normal;

    vec3 lightDirection = normalize(frame.directionalLightDirectionAngularRadius.xyz);
    vec3 lightTangent = normalize(cross(
        abs(lightDirection.y) < 0.98 ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0),
        lightDirection));
    vec3 lightBitangent = cross(lightDirection, lightTangent);
    float angularScale = tan(frame.directionalLightDirectionAngularRadius.w);
    uint state = uint(pixel.x) * 1973u ^ uint(pixel.y) * 9277u ^ 0x68bc21ebu;
    // Deliberately keep the path sequence fixed. Without a temporal denoiser,
    // changing it each frame makes individual macro fibres shimmer.

    vec3 origin = world + normal * frame.lightingParameters.w;
    uint lightSamples = max(1u,
        (frame.extentFlags.z >> kDirectionalSampleShift) & kSampleMask);
    float lightVisibility = 0.0;
    float diskRotation = random01(state) * 6.28318530718;
    for (uint rayIndex = 0u; rayIndex < lightSamples; ++rayIndex) {
        float u = (float(rayIndex) + 0.5) / float(lightSamples);
        float angle = diskRotation + float(rayIndex) * 2.39996322973;
        vec2 disk = sqrt(u) * vec2(cos(angle), sin(angle));
        vec3 direction = normalize(lightDirection +
            (lightTangent * disk.x + lightBitangent * disk.y) * angularScale);
        float hitDistance = firstHitDistance(
            origin, direction, frame.cameraPositionMaximumDistance.w);
        // A near fibre blocks most of the key path but retains a small
        // forward-scatter lobe. Distant opaque blockers remain effectively dark.
        float hit = step(frame.cameraPositionMaximumDistance.w - 1e-5, hitDistance);
        float nearTransmission = 0.38 + 0.22 * smoothstep(0.0, 0.022, hitDistance);
        lightVisibility += mix(nearTransmission, 1.0, hit);
    }
    lightVisibility /= float(lightSamples);

    uint aoSamples = max(1u, (frame.extentFlags.z >> kAoSampleShift) & kSampleMask);
    float openPaths = 0.0;
    for (uint rayIndex = 0u; rayIndex < aoSamples; ++rayIndex) {
        vec3 direction = cosineHemisphere(normal, state);
        float hitDistance = firstHitDistance(origin, direction, frame.lightingParameters.z);
        openPaths += smoothstep(0.0, frame.lightingParameters.z, hitDistance);
    }
    openPaths /= float(aoSamples);

    // This low-sample transport is a fibre lobe, not a whole-room lighting
    // pass. Previously its key visibility and AO multiplied every shaded
    // pixel, making the fixed screen-space samples hatch and crawl across
    // tiles, walls and quartz. A tighter chroma mask also excludes the muted
    // sage cabinetry while retaining the fluorescent tennis felt.
    float queriedKey = mix(1.0, lightVisibility,
        clamp(frame.lightingParameters.x * 0.68, 0.0, 1.0));
    float queriedAo = mix(1.0, 0.76 + 0.24 * openPaths,
        clamp(frame.lightingParameters.y, 0.0, 1.0));
    float keyFactor = mix(1.0, queriedKey, fibreMask);
    float aoFactor = mix(1.0, queriedAo, fibreMask);

    // Kajiya-Kay-style macro sheen inferred from the visible cylinder normal.
    // Geometry still owns the primary shading; these queried paths contribute
    // self-shadow, inter-fibre openness and a restrained multiple-scatter lift.
    vec3 apparentTangent = normalize(cross(normal, toCamera));
    vec3 halfVector = normalize(lightDirection + toCamera);
    float tangentHalf = clamp(dot(apparentTangent, halfVector), -1.0, 1.0);
    float anisotropic = pow(sqrt(max(0.0, 1.0 - tangentHalf * tangentHalf)), 34.0);
    float rim = pow(1.0 - max(dot(normal, toCamera), 0.0), 2.0);
    vec3 chroma = base / max(max(base.r, base.g), max(base.b, 0.08));
    vec3 multiScatter = chroma * fibreMask *
        (0.022 + 0.042 * openPaths + 0.035 * rim) *
        (0.35 + 0.65 * lightVisibility);
    vec3 sheen = vec3(0.84, 0.91, 0.54) * fibreMask * anisotropic *
        lightVisibility * (0.010 + 0.020 * rim);
    imageStore(hdrColor, pixel, vec4(base * keyFactor * aoFactor + multiScatter + sheen, source.a));
}
